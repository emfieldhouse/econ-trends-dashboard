# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# Environment variables (contains your API key — never commit this)
.env

# Data (raw/processed data shouldn't be committed — it's regenerated by scripts)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Jupyter
.ipynb_checkpoints/

# IDE / editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
